{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bitora-api",
  "main": "worker.js",
  "compatibility_date": "2026-10-21",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bitora-dev",
      "database_id": "REPLACE_WITH_CLOUDFLARE_D1_DATABASE_ID"
    }
  ]
}
